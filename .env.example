# Django
DEBUG=1
DATABASE_URL=postgres://user:password@localhost:5432/needsafrica

# URL of the needsafricafe frontend, used for CORS and redirect links
FRONTEND_URL=http://localhost:5173

# Cloudinary — media storage for project photos
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack — NGN donations
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# PayPal — international donations
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_PAYMENT_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# SendGrid — transactional email
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
